{
	"name": "end-of-week",
	"version": "2.0.0",
	"description": "Get the last day of a week (Sunday) according to UTC",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"index.ts"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "tsx --test test.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm test && npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ad-si/end-of-week.git"
	},
	"keywords": [
		"week",
		"date",
		"utc",
		"iso8601",
		"calendar"
	],
	"author": "Adrian Sieber",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ad-si/end-of-week/issues"
	},
	"homepage": "https://github.com/ad-si/end-of-week#readme",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0"
	}
}
